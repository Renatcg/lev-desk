{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps --force",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "rewrites": [
    {
      "source": "/landbank",
      "destination": "/api/landbank-proxy"
    },
    {
      "source": "/landbank/:path*",
      "destination": "/api/landbank-proxy?path=:path*"
    },
    {
      "source": "/lev-desk/landbank",
      "destination": "/api/landbank-proxy"
    },
    {
      "source": "/lev-desk/landbank/:path*",
      "destination": "/api/landbank-proxy?path=:path*"
    }
  ]
}
